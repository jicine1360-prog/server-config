[Unit]
Description=llama-server Qwen3.8-Flash-Next UNCENSORED IQ4_XS
After=network.target
Before=openclaw-gateway.service

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=0,1,2,3,4,5
ExecStart=/home/hoony/llama.cpp-qwen4/build/bin/llama-server \
  -m /home/hoony/models/Qwen3.8-Flash-Next-Uncensored-IQ4_XS/Qwen3.8-Flash-Next-Uncensored-IQ4_XS-00001-of-00003.gguf \
  --mmproj /home/hoony/models/mmproj/mmproj-Qwen3.8-Flash-Next-BF16.gguf \
  --device CUDA0,CUDA1,CUDA2,CUDA3,CUDA4,CUDA5 \
  -ngl 0 \
  -c 131072 \
  -t 24 \
  -b 2048 -ub 1024 \
  -fa on \
  --reasoning-budget 128 \
  --chat-template-kwargs '{"enable_thinking":false}' \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --host 127.0.0.1 \
  --port 8086 \
  --alias qwen3.8-flash-next
ExecStartPost=/bin/sh -c 'for i in $(seq 1 180); do if curl -sf http://127.0.0.1:8086/health >/dev/null; then exit 0; fi; sleep 5; done; exit 1'
TimeoutStartSec=900
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
